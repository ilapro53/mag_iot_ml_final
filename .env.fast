# ====================================================================
# ПРЕСЕТ: БЫСТРОЕ модельное время (сутки за ~38 секунд).
# Лучше всего для Python-визуализатора (visualize.py) — суточные циклы
# видно сразу. В Home Assistant при этом сутки сжимаются (ось HA реальная).
#
# Активировать:
#   copy .env.fast .env
#   docker compose up -d --force-recreate sensor
# (это копия текущего .env)
# ====================================================================

# Подключение к MQTT-брокеру — единый источник правды для сенсора, Home Assistant и тестов.
#
# Docker:     MQTT_HOST = имя сервиса 'mosquitto' (контейнеры видят друг друга по имени).
# Ubuntu-ВМ:  поменять на IP брокер-машины, напр. MQTT_HOST=192.168.1.65 — код менять НЕ нужно.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=mqtt_exp
MQTT_PASSWORD=pass_mqtt

# Порт публикации брокера на ХОСТ (Windows). Внутри Docker всегда 1883 — это НЕ трогаем.
# Windows зарезервировал 1883 -> ставим другой, напр. 18883. С хоста тогда: localhost:18883.
MQTT_HOST_PORT=18883

# Порт веб-интерфейса Home Assistant на хосте. Если 8123 занят/зарезервирован — поменяй.
HA_HOST_PORT=8123

# Префикс топиков фермы (из прошлой практики «Вариант Б»: farm/ilya/<датчик>)
TOPIC_PREFIX=farm/ilya

# Длина «суток» в секундах (суточный цикл день/ночь). Меньше = время в теплице идёт быстрее.
# 300 = сутки за 5 мин; 150 = x2; 37.5 = ещё x4 (сутки за ~38 секунд).
DAY_PERIOD_SEC=37.5

# Частота публикации датчиков: множитель к интервалам. 1 = как задумано, 4 = в 4 раза чаще.
RATE_MULT=4
