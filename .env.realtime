# ====================================================================
# ПРЕСЕТ: РЕАЛЬНОЕ (медленное) модельное время, сутки за 30 минут.
# Лучше всего для Home Assistant: на его реальной оси суточный ход
# выглядит как нормальная "теплица за день", без сжатия.
#
# Активировать:
#   copy .env.realtime .env
#   docker compose up -d --force-recreate sensor
# Затем дать стенду поработать около 30-60 минут, в HA появится 1-2 плавных суточных цикла.
# (хочешь еще медленнее и реалистичнее, поставь DAY_PERIOD_SEC=3600, сутки за 1 час)
# ====================================================================

# Подключение к MQTT-брокеру - единый источник правды для сенсора, Home Assistant и тестов.
#
# Docker: MQTT_HOST = имя сервиса 'mosquitto' (контейнеры видят друг друга по имени).
# Ubuntu-ВМ: поменять на IP брокер-машины, напр. MQTT_HOST=192.168.1.65, код менять НЕ нужно.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=mqtt_exp
MQTT_PASSWORD=pass_mqtt

# Порт публикации брокера на ХОСТ (Windows). Внутри Docker всегда 1883, это НЕ трогаем.
# Windows зарезервировал 1883, ставим другой, напр. 18883. С хоста тогда: localhost:18883.
MQTT_HOST_PORT=18883

# Порт веб-интерфейса Home Assistant на хосте. Если 8123 занят/зарезервирован, поменяй.
HA_HOST_PORT=8123

# Префикс топиков фермы (из прошлой практики "Вариант Б": farm/ilya/<датчик>)
TOPIC_PREFIX=farm/ilya

# Длина "суток" в секундах. Для HA берем медленно: 1800 = сутки за 30 минут (реальное время).
# (300 = 5 мин, 3600 = 1 час, выбирай под длительность демонстрации)
DAY_PERIOD_SEC=1800

# Частота публикации датчиков. Для долгого прогона в HA хватает 1 (меньше нагрузка на базу истории).
RATE_MULT=1
