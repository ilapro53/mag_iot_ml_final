# Шаблон конфигурации. Скопируй в .env и при необходимости поменяй значения.
#
# Docker: MQTT_HOST = имя сервиса 'mosquitto'.
# Ubuntu-ВМ: MQTT_HOST = IP брокер-машины, напр. 192.168.1.65 (код менять НЕ нужно).
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=mqtt_exp
MQTT_PASSWORD=pass_mqtt

# Порт публикации брокера на ХОСТ. Внутри Docker всегда 1883.
# Если хостовый 1883 занят/зарезервирован Windows, поставь другой, напр. 18883.
MQTT_HOST_PORT=18883

# Порт веб-интерфейса Home Assistant на хосте.
HA_HOST_PORT=8123

# Префикс топиков фермы: farm/ilya/<датчик>
TOPIC_PREFIX=farm/ilya

# Длина "суток" в секундах (суточный цикл день/ночь в данных). 300 = цикл за 5 минут.
DAY_PERIOD_SEC=300

# Частота публикации датчиков: множитель к интервалам. 1 = как задумано, 4 = в 4 раза чаще.
RATE_MULT=1
